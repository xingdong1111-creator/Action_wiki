{"config":{"lang":["zh"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Action","text":"<p>\u200b\u4e2a\u4eba\u200b\u77e5\u8bc6\u5e93\u200b\u2014\u2014\u200b\u4ece\u200b\u539f\u7406\u200b\u5230\u200b\u5de5\u7a0b\u200b\u9010\u5c42\u200b\u62c6\u89e3\u200b\u3002</p>"},{"location":"#_1","title":"\u2726 \u200b\u7cfb\u5217","text":"\u7cfb\u5217\u200b \u200b\u5185\u5bb9\u200b \u200b\u7bc7\u6570\u200b \u200b\u5927\u200b\u6a21\u578b\u200b LLM \u200b\u67b6\u6784\u200b\u4e0e\u200b\u8bad\u7ec3\u200b\u6280\u672f\u200b\u7b14\u8bb0\u200b 1 \u200b\u968f\u7b14\u200b \u200b\u6742\u8bb0\u200b 0"},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/","title":"\u5927\u200b\u6a21\u578b","text":"<p>LLM \u200b\u67b6\u6784\u200b\u4e0e\u200b\u8bad\u7ec3\u200b\u6280\u672f\u200b\u7b14\u8bb0\u200b\u3002</p> <ul> <li>Kimi K3 \u200b\u67b6\u6784\u200b\u5206\u6790\u200b\uff08MoE \u200b\u4e0e\u200b Attention\uff09</li> </ul>"},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/","title":"Kimi K3 \u200b\u67b6\u6784\u200b\u5206\u6790\u200b\uff08MoE \u200b\u4e0e\u200b Attention\uff09","text":"<p>[!INFO] \u200b\u6e90\u200b\u6587\u7ae0\u200b \u200b\u6e90\u200b\u6587\u7ae0\u200b\uff1a\u200b\u79d1\u5b66\u200b\u7a7a\u95f4\u200b\u300a\u200b\u7b80\u5355\u200b\u8c08\u8c08\u200bK3\u200b\u7684\u200bMoE\u200b\u548c\u200bAttention\u300b\uff08\u200b\u82cf\u5251\u6797\u200b\uff0c2026-08-04\uff09\u3002\u200b\u4e00\u53e5\u200b\u8bdd\u200b\uff1aK3 = KDA + MLA + Stable LatentMoE + AttnRes\uff1b\u200b\u4f18\u5316\u200b\u5668\u200b\u4ecd\u200b\u662f\u200b Moonlight \u200b\u7248\u200b Muon\uff08Attention \u200b\u6743\u91cd\u200b\u6539\u200b Per-Head \u200b\u4f18\u5316\u200b\uff0c\u200b\u52a8\u673a\u200b\u662f\u200b\u6b63\u786e\u6027\u200b\u800c\u200b\u975e\u200b\u6548\u679c\u200b\u2014\u2014\"\u200b\u6bcf\u4e2a\u200b Head \u200b\u672c\u200b\u5c31\u200b\u72ec\u7acb\u200b\uff0c\u200b\u4e0d\u200b\u5e94\u200b\u8026\u5408\u200b\"\uff09\u3002\u200b\u4e3b\u65cb\u5f8b\u200b\uff1a\u200b\u6548\u679c\u200b\u3001\u200b\u6548\u7387\u200b\u3001\u200b\u7a33\u5b9a\u6027\u200b\u7684\u200b\u534f\u8c03\u200b\u3002AttnRes \u200b\u89c1\u200b\u300aAttention Residuals \u200b\u56de\u5fc6\u5f55\u200b\u300b\uff0cKDA \u200b\u89c1\u200b\u300aKimi Linear\u300b\u200b\u6280\u672f\u200b\u62a5\u544a\u200b\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#1-silu-swiglu","title":"1. SiLU \u200b\u4e0e\u200b SwiGLU \u200b\u7684\u200b\u75c5\u6839","text":"","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#11-silu","title":"1.1 SiLU \u200b\u672c\u4f53","text":"<p>\\(SiLU(x) = x \\cdot \\sigma(x)\\)\uff08aka Swish\uff09\u3002\u200b\u4e09\u4e2a\u200b\u5173\u952e\u200b\u7279\u5f81\u200b\uff1a\u200b\u6b63\u533a\u200b \u2248 \u200b\u6052\u7b49\u200b\uff08\u200b\u7ebf\u6027\u200b\u589e\u957f\u200b\u3001\u200b\u65e0\u4e0a\u754c\u200b\uff09\uff1b\u200b\u8d1f\u533a\u200b\u5c0f\u200b\u51f9\u5751\u200b\uff08x\u2248-1.28 \u200b\u5904\u200b\u6700\u4f4e\u200b \u2248 -0.278\uff09\u200b\u540e\u200b\u5f52\u96f6\u200b\uff1b\u200b\u81ea\u200b\u95e8\u63a7\u200b\uff08\u03c3(x) \u200b\u662f\u200b 0\\~1 \u200b\u8f6f\u200b\u5f00\u5173\u200b\uff09\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#12-swiglu","title":"1.2 \u200b\u5728\u200b SwiGLU \u200b\u91cc\u200b\u7684\u200b\u4f4d\u7f6e","text":"<p>\\(SwiGLU(x) = W_3\\big(\\mathrm{SiLU}(W_1 x) \\odot W_2 x\\big)\\)\uff1a\u200b\u95e8\u63a7\u200b\u5206\u652f\u200b\uff08\u200b\u653e\u884c\u200b\u591a\u5c11\u200b\uff09\u00d7 \u200b\u7ebf\u6027\u200b\u5206\u652f\u200b\uff08\u200b\u5185\u5bb9\u200b\u672c\u4f53\u200b\uff09\u3002\u200b\u5b9e\u8bc1\u200b\u7a33\u8d62\u200b GELU/ReLU FFN\uff0c\u200b\u662f\u200b Llama/Qwen/K2 \u200b\u5168\u7cfb\u200b\u6807\u914d\u200b\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#13-ox4","title":"1.3 \u200b\u75c5\u6839\u200b\uff1a\u200b\u6b63\u533a\u200b\u65e0\u200b\u4e0a\u754c\u200b \u00d7 \u200b\u4e58\u6027\u200b\u7ed3\u6784\u200b = O(\u2016x\u2016\u2074)","text":"<ol> <li>\u200b\u95e8\u63a7\u200b\u7206\u200b\uff1aW1 \u200b\u67d0\u200b\u4e00\u884c\u200b w \u200b\u4e0e\u200b\u8f93\u5165\u200b x \u200b\u540c\u200b\u5411\u200b\uff08align\uff09\u200b\u65f6\u200b |w\u00b7x| \u200b\u53ef\u4ee5\u200b\u975e\u5e38\u200b\u5927\u200b\uff0c\u200b\u800c\u200b SiLU \u200b\u5bf9\u5927\u200b\u6b63\u503c\u200b \u2248 \u200b\u6052\u7b49\u200b\uff0c\u200b\u4e00\u70b9\u200b\u4e0d\u62e6\u200b\uff1b</li> <li>\u200b\u7ebf\u6027\u200b\u5206\u652f\u200b\u540c\u65f6\u200b\u7206\u200b\uff1aW2\u00b7x \u200b\u5728\u200b\u540c\u4e00\u200b\u901a\u9053\u200b\u4e5f\u200b\u5927\u200b\uff1b</li> <li>\u200b\u76f8\u4e58\u200b\uff1a\u200b\u4e24\u4e2a\u200b O(\u2016x\u2016\u00b2) \u200b\u91cf\u7ea7\u200b\u7684\u200b\u6570\u200b\u76f8\u4e58\u200b \u2192 O(\u2016x\u2016\u2074) \u200b\u7ea7\u200b\u5f02\u5e38\u200b\u503c\u200b\u3002</li> </ol> <p>\u200b\u8fd9\u200b\u5c31\u662f\u200b LLM \u200b\u91cc\u200b\u5927\u540d\u9f0e\u9f0e\u200b\u7684\u200b activation outlier\uff08LLM.int8() / SmoothQuant \u200b\u4e00\u200b\u65cf\u200b\u91cf\u5316\u200b\u5de5\u4f5c\u200b\u6536\u62fe\u200b\u7684\u200b\u5c31\u662f\u200b\u5b83\u200b\uff09\uff0cSwiGLU \u200b\u7684\u200b\u4e58\u6027\u200b\u7ed3\u6784\u200b\u662f\u200b\u653e\u5927\u5668\u200b\uff1bBF16/FP8 \u200b\u4f4e\u200b\u7cbe\u5ea6\u200b\u8bad\u7ec3\u200b\u4e0b\u8f7b\u200b\u5219\u200b\u6bc1\u200b\u7edf\u8ba1\u200b\u91cf\u200b\u3001\u200b\u91cd\u200b\u5219\u200b inf\u3002\u200b\u5173\u952e\u200b\u8ba4\u8bc6\u200b\uff1a\u200b\u95ee\u9898\u200b\u4e0d\u200b\u5728\u200b SiLU \u200b\u672c\u8eab\u200b\uff0c\u200b\u5728\u4e8e\u200b\"\u200b\u6b63\u533a\u200b\u65e0\u9650\u200b\u5e45\u200b\" + \"\u200b\u4e24\u200b\u5206\u652f\u200b\u76f8\u4e58\u200b\"\u200b\u7684\u200b\u7ec4\u5408\u200b\u3002</p> <p> \u200b\u5ef6\u4f38\u200b\uff1a\u200b\u51e1\u662f\u200b\u4e22\u6389\u200b softmax \u200b\u8fd9\u200b\u628a\u200b\"\u200b\u6570\u503c\u200b\u5b89\u5168\u200b\u9501\u200b\"\u200b\u7684\u200b\u6ce8\u610f\u529b\u200b\u53d8\u4f53\u200b\uff08\u200b\u7ebf\u6027\u200b\u6ce8\u610f\u529b\u200b\u7b49\u200b\uff09\uff0c\u200b\u6570\u503c\u200b\u8303\u56f4\u200b\u90fd\u200b\u8981\u200b\u9760\u200b\u6fc0\u6d3b\u200b\u51fd\u6570\u200b/\u200b\u9650\u5e45\u200b\u81ea\u4fee\u200b\u95f8\u95e8\u200b\u2014\u2014K3 \u200b\u7684\u200b softcap \u200b\u4e0e\u200b\u8fd9\u7c7b\u200b\u786c\u200b\u95f8\u200b\uff08ReLU6 \u200b\u5f0f\u200b\u622a\u65ad\u200b\uff09\u200b\u662f\u200b\u540c\u4e00\u200b\u95ee\u9898\u200b\u7684\u200b\u4e24\u79cd\u200b\u89e3\u6cd5\u200b\uff0csoftcap \u200b\u5e73\u6ed1\u200b\u4e14\u200b\u540c\u6837\u200b\u754c\u9650\u200b\u4e0b\u200b\u6548\u679c\u200b\u66f4\u597d\u200b\u3002 </p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#2-latentmoe","title":"2. LatentMoE\uff1a\u200b\u539f\u7406\u200b\u4e0e\u200b\u597d\u5904","text":"","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#21-moe","title":"2.1 \u200b\u666e\u901a\u200b MoE \u200b\u7684\u200b\u4e24\u672c\u200b\u8d26","text":"<p>\u200b\u6bcf\u4e2a\u200b expert \u200b\u662f\u200b FFN\uff1ad \u2192 h \u2192 d\uff08K2/K3 \u200b\u7684\u200b d=7168\uff09\uff0cn \u200b\u4e2a\u200b\u4e13\u5bb6\u200b\u9009\u200b k \u200b\u4e2a\u200b\uff1a</p> \u200b\u6bcf\u200b token \u200b\u8ba1\u7b97\u200b \u200b\u603b\u200b\u53c2\u6570\u200b\uff08\u200b\u77e5\u8bc6\u200b\u5bb9\u91cf\u200b\uff09 \u200b\u666e\u901a\u200b MoE k \u00d7 2dh n \u00d7 2dh LatentMoE 2k \u00d7 (d\u00b7h) + \u200b\u5171\u4eab\u200b\u6295\u5f71\u200b \u2248 \u200b\u6301\u5e73\u200b 2n \u00d7 dh = n \u00d7 2dh\uff08\u200b\u6301\u5e73\u200b\uff09","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#22","title":"2.2 \u200b\u7ed3\u6784","text":"<pre><code>\u200b\u666e\u901a\u200b MoE:    d \u2500\u2500\u2192 D \u2500\u2500\u2192 d            \uff08n \u200b\u9009\u200b k\uff0c\u200b\u4e13\u5bb6\u200b\u5168\u5bbd\u200b\uff09\nLatentMoE:   d \u2500\u2500\u2192 d/2 \u2500\u2500\u2192 D \u2500\u2500\u2192 d/2 \u2500\u2500\u2192 d\n              \u200b\u964d\u7ef4\u200b(\u200b\u5171\u4eab\u200b)   2n \u200b\u9009\u200b 2k     \u200b\u5347\u7ef4\u200b(\u200b\u5171\u4eab\u200b\uff09\n                        \uff08\u200b\u4e13\u5bb6\u200b\u5728\u200b\u534a\u200b\u5bbd\u200b\u7a7a\u95f4\u200b\u5e72\u6d3b\u200b\uff09\n</code></pre> <p>\u200b\u964d\u200b/\u200b\u5347\u7ef4\u200b\u6295\u5f71\u200b\u4e3a\u200b\u6240\u6709\u200b routed expert \u200b\u5171\u4eab\u200b\uff0c\u200b\u6bcf\u4e2a\u200b\u4e13\u5bb6\u200b\u53ea\u200b\u5728\u200b d/2 \u200b\u5bbd\u200b\u7a7a\u95f4\u200b\u91cc\u200b\u505a\u200b d/2\u2192D\u2192d/2\u3002\u200b\u6838\u5fc3\u200b\uff1a2n \u200b\u4e2a\u200b\u534a\u200b\u5bbd\u200b\u4e13\u5bb6\u200b \u2248 n \u200b\u4e2a\u200b\u5168\u5bbd\u200b\u4e13\u5bb6\u200b\u7684\u200b\u603b\u53c2\u200b\u6570\u91cf\u200b\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#23","title":"2.3 \u200b\u597d\u5904","text":"<ul> <li>\u200b\u77e5\u8bc6\u200b\u5207\u5206\u200b\u66f4\u7ec6\u200b\uff1a448 \u200b\u4e2a\u200b\"\u200b\u5168\u79d1\u200b\u5927\u592b\u200b\" \u2192 896 \u200b\u4e2a\u200b\"\u200b\u4e13\u79d1\u200b\u5927\u592b\u200b\"\uff1b</li> <li>\u200b\u7ec4\u5408\u200b\u7a7a\u95f4\u200b\u6307\u6570\u200b\u53d8\u200b\u5927\u200b\uff1aC(448,8) \u2192 C(896,16)\u2014\u2014\u200b\u5bb9\u91cf\u200b\u6ca1\u200b\u53d8\u200b\uff0c\u200b\u8868\u8fbe\u200b\u81ea\u7531\u5ea6\u200b\u5927\u589e\u200b\uff1b</li> <li>\u200b\u5373\u200b\u8bba\u6587\u200b\u6807\u9898\u200b\u300aToward Optimal Accuracy per FLOP and Parameter\u300b\uff1a\u200b\u540c\u200b\u6210\u672c\u200b\u4e0b\u200b\u6548\u679c\u200b\u7565\u200b\u597d\u200b\u3002</li> </ul>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#24-k3","title":"2.4 K3 \u200b\u843d\u5730","text":"<p>448\u200b\u9009\u200b8 \u2192 896 \u200b\u9009\u200b 16\uff08\u200b\u7a00\u758f\u200b\u5ea6\u200b\u4e0d\u53d8\u200b 1/56\uff09\uff1blatent \u200b\u5bbd\u5ea6\u200b 3584 = 7168/2\uff1b2 \u200b\u4e2a\u200b shared expert \u200b\u4fdd\u6301\u200b\u5168\u5bbd\u200b\u2014\u2014\u200b\u901a\u7528\u200b\u8ba1\u7b97\u200b\u4e0d\u200b\u88ab\u200b\u4f4e\u7ef4\u200b\u74f6\u9888\u200b\u5361\u4f4f\u200b\uff1a\"\u200b\u901a\u7528\u200b\u7684\u200b\u4e8b\u200b\u8d70\u200b\u5927\u8def\u200b\uff0c\u200b\u4e13\u7cbe\u200b\u7684\u200b\u4e8b\u200b\u94bb\u200b\u5c0f\u8def\u200b\"\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#25-stable","title":"2.5 \u200b\u4ee3\u4ef7\u200b\uff1a\u200b\u56db\u4e2a\u200b\u77e9\u9635\u200b\u8fde\u4e58\u200b \u2192 \"Stable\" \u200b\u4e09\u4ef6\u5957","text":"<pre><code>d \u2500\u2500W_down\u2500\u2500\u2192 d/2 \u2500\u2500W1\u2500\u2500\u2192 D \u2500\u2500W3\u2500\u2500\u2192 d/2 \u2500\u2500W_up\u2500\u2500\u2192 d\n     \u2460\u200b\u77e9\u9635\u200b      \u2461\u200b\u77e9\u9635\u200b(\u200b\u95e8\u63a7\u200b)  \u2462\u200b\u77e9\u9635\u200b     \u2463\u200b\u77e9\u9635\u200b\n</code></pre> <p>\u200b\u88f8\u200b\u7ebf\u6027\u200b\u94fe\u200b + \u200b\u4e58\u6027\u200b\u95e8\u63a7\u200b\uff0c\u200b\u6570\u503c\u200b\u6781\u200b\u4e0d\u200b\u7a33\u5b9a\u200b\uff0c\u200b\u5f02\u5e38\u200b\u503c\u987a\u200b\u56db\u4e2a\u200b\u77e9\u9635\u200b\u4e00\u8def\u200b\u653e\u5927\u200b\u3002\u200b\u4e09\u4ef6\u200b\u4fdd\u9669\u200b\u5168\u662f\u200b\u7ed9\u200b\u8fd9\u200b\u6761\u94fe\u200b\u4e0a\u200b\u7684\u200b\uff1a</p> \u200b\u4fdd\u9669\u200b \u200b\u4f4d\u7f6e\u200b \u200b\u4f5c\u7528\u200b SiTU-GLU \u200b\u4e13\u5bb6\u200b\u5185\u90e8\u200b softcap \u200b\u5c01\u9876\u200b O(\u2016x\u2016\u2074) \u200b\u5f02\u5e38\u200b\u503c\u200b\uff08\u03b21=4 \u200b\u95e8\u63a7\u200b\u3001\u03b22=25 \u200b\u7ebf\u6027\u200b\uff1bsoftcap \u200b\u4f18\u4e8e\u200b Hard Clip\uff09 RMS Norm \u200b\u5347\u7ef4\u524d\u200b\uff08W_up \u200b\u4e4b\u524d\u200b\uff09 \u200b\u6d88\u878d\u200b\u663e\u793a\u200b\u8fd9\u4e2a\u200b\u4f4d\u7f6e\u200b\u6700\u200b\u672c\u8d28\u200b\uff08\u200b\u6700\u5c0f\u200b\u6539\u52a8\u200b\u539f\u5219\u200b\u53ea\u7559\u200b\u8fd9\u200b\u4e00\u4e2a\u200b\uff09\uff1b\u200b\u5f69\u86cb\u200b\uff1a\u200b\u5bf9\u200b valid loss \u200b\u5f71\u54cd\u200b\u4e0d\u200b\u5927\u200b\uff0c\u200b\u4f46\u200b\u67d0\u4e9b\u200b benchmark \u200b\u4e0d\u52a0\u4f1a\u200b\u7a33\u5b9a\u200b\u53d8\u5dee\u200b\u2014\u2014\u200b\u731c\u6d4b\u200b\u5e73\u8861\u200b\u4e86\u200b Routed/Shared \u200b\u6bd4\u4f8b\u200b\uff0c\u200b\u52a0\u200b\u4e86\u200b\u5c31\u200b\u4e0d\u7528\u200b Scaling Factor QB \u200b\u8def\u7531\u200b\u4fa7\u200b 896 \u200b\u4e13\u5bb6\u200b\u7684\u200b\u8d1f\u8f7d\u200b\u5747\u8861\u200b\uff08\u200b\u89c1\u200b\u7b2c\u200b 3 \u200b\u8282\u200b\uff09","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#3-moe-aux-loss-qb","title":"3. MoE \u200b\u8d1f\u8f7d\u200b\u5747\u8861\u200b\uff1a\u200b\u4ece\u200b aux loss \u200b\u5230\u200b QB","text":"","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#31","title":"3.1 \u200b\u4f20\u7edf\u200b\u524d\u5411\u200b\u6d41\u7a0b\u200b\uff08\u200b\u516d\u6b65\u200b\uff09","text":"<pre><code>\u2460 \u200b\u6253\u5206\u200b   s_i = w_i\u00b7x                    \uff08router \u200b\u7ed9\u200b 896 \u200b\u4e13\u5bb6\u200b\u5404\u6253\u200b\u4e00\u5206\u200b\uff09\n\u2461 \u200b\u9009\u62e9\u200b   Top-k over (s_i + b_i)         \uff08b_i \u200b\u662f\u200b\u5747\u8861\u200b\u504f\u7f6e\u200b\uff09\n\u2462 \u200b\u95e8\u63a7\u200b   p_i = \u03c3(s_i) \u200b\u6216\u200b softmax        \u2190 \u200b\u7528\u200b\u3010\u200b\u4e0d\u5e26\u200b b\u3011\u200b\u7684\u200b\u539f\u200b\u5206\u6570\u200b\n\u2463 \u200b\u5206\u53d1\u200b   token \u200b\u53d1\u7ed9\u200b\u9009\u4e2d\u200b\u4e13\u5bb6\u200b\u6240\u5728\u200b\u5361\u200b        \uff08EP \u200b\u4e0b\u200b all-to-all \u200b\u901a\u4fe1\u200b\uff09\n\u2464 \u200b\u8ba1\u7b97\u200b   y_i = E_i(x)\n\u2465 \u200b\u5408\u5e76\u200b   y = \u03a3 p_i\u00b7y_i (+ shared expert \u200b\u8f93\u51fa\u200b\uff09\n</code></pre> <p>\u200b\u5173\u952e\u200b\u7ec6\u8282\u200b\uff1abias \u200b\u53ea\u200b\u53c2\u4e0e\u200b\"\u200b\u9009\u200b\u8c01\u200b\"\uff08\u2461\uff09\uff0c\u200b\u4e0d\u200b\u53c2\u4e0e\u200b\"\u200b\u7ed9\u200b\u591a\u5c11\u200b\u6743\u91cd\u200b\"\uff08\u2462\uff09\u2014\u2014\u200b\u5747\u8861\u5668\u200b\u53ea\u6539\u200b\u8def\u7531\u200b\u51b3\u7b56\u200b\uff0c\u200b\u4e0d\u200b\u6c61\u67d3\u200b\u8f93\u51fa\u200b\u8bed\u4e49\u200b\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#32","title":"3.2 \u200b\u8d1f\u8f7d\u200b\u4e0d\u200b\u5747\u8861\u200b\u95ee\u9898","text":"<p>Router \u200b\u8bad\u7ec3\u200b\u4f1a\u5bcc\u8005\u200b\u6108\u5bcc\u200b\uff1a\u200b\u65e9\u671f\u200b\u88ab\u200b\u591a\u9009\u200b \u2192 \u200b\u68af\u5ea6\u200b\u591a\u200b \u2192 \u200b\u66f4\u5f3a\u200b \u2192 \u200b\u66f4\u200b\u88ab\u200b\u591a\u9009\u200b\u3002\u200b\u540e\u679c\u200b\uff1a\u200b\u5bb9\u91cf\u200b\u6d6a\u8d39\u200b + EP \u200b\u4e0b\u200b\u6700\u5fd9\u200b\u7684\u200b\u5361\u200b\u662f\u200b\u77ed\u677f\u200b\uff0c\u200b\u5168\u200b\u96c6\u7fa4\u200b\u7b49\u200b\u5b83\u200b\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#33","title":"3.3 \u200b\u4e09\u4ee3\u200b\u505a\u6cd5\u200b\u5bf9\u6bd4","text":"\u505a\u6cd5\u200b \u200b\u673a\u5236\u200b \u200b\u5e72\u6270\u200b\u4e3b\u200b\u4efb\u52a1\u200b \u200b\u8d85\u53c2\u200b \u200b\u5927\u89c4\u6a21\u200b\uff08896\uff09\u200b\u8868\u73b0\u200b aux loss\uff08Switch \u200b\u65f6\u4ee3\u200b\uff09 loss \u200b\u91cc\u52a0\u200b\u5747\u8861\u200b\u9879\u200b\uff08f_i\u00b7P_i\uff09 \u200b\u6709\u200b\uff08\u03b1 \u200b\u8c03\u548c\u200b\uff09 \u03b1 \u200b\u4e00\u822c\u200b\uff0c\u200b\u8f6f\u200b\u5747\u8861\u200b Loss-Free\uff08K2/DSv3\uff09 bias \u200b\u6309\u200b sign \u200b\u8bd5\u9519\u200b\uff1ab \u2190 b \u2212 u\u00b7sign(f\u0304\u22121/n) \u200b\u65e0\u200b \u200b\u6b65\u957f\u200b u \u200b\u4e0d\u200b\u7a33\u200b\uff1abinary \u200b\u53cd\u9988\u200b\u592a\u200b\u7c97\u7cd9\u200b\uff0c\u200b\u9010\u200b\u6bd4\u7279\u200b\u632a\u52a8\u200b\u4f1a\u200b\u9707\u8361\u200b QB\uff08K3\uff09 bias = \u200b\u4f59\u91cf\u200b\u5206\u5e03\u200b\u7684\u200b k/n \u200b\u5206\u200b\u4f4d\u6570\u200b\uff08\u200b\u95ed\u5f0f\u200b\uff09 \u200b\u65e0\u200b \u200b\u65e0\u200b \u200b\u7a33","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#34-qb","title":"3.4 QB \u200b\u63a8\u5bfc\u200b\u94fe","text":"<p>\u200b\u5747\u8861\u200b\u7684\u200b\u6570\u5b66\u200b\u76ee\u6807\u200b\uff1a\u200b\u6bcf\u200b\u4e13\u5bb6\u200b\u88ab\u200b\u9009\u200b\u6982\u7387\u200b = k/n\uff08896 \u200b\u9009\u200b 16 \u2192 1/56 \u2248 1.8%\uff09\u3002\u200b\u5165\u9009\u200b\u95e8\u69db\u200b = top-k \u200b\u5361\u200b\u7684\u200b\u7ebf\u200b = \u200b\u7b2c\u200b k+1 \u200b\u5927\u200b\u7684\u200b\u5206\u6570\u200b \\(\\tau_t\\)\u3002\u200b\u4e13\u5bb6\u200b i \u200b\u5165\u9009\u200b \u21d4\uff1a</p> <p>\\(s_i + b_i &gt; \\tau_t \\;\\Leftrightarrow\\; d_t := \\tau_t - s_i &lt; b_i\\)\u3000\uff08\\(d_t\\) = \"\u200b\u4f59\u91cf\u200b\"\uff1a\u200b\u79bb\u200b\u5165\u9009\u200b\u8fd8\u200b\u5dee\u200b\u591a\u5c11\u200b\uff09</p> <p>\u200b\u4e8e\u662f\u200b\u88ab\u200b\u9009\u200b\u6982\u7387\u200b = P(d_t &lt; b_i)\uff0c\u200b\u8981\u200b\u5b83\u200b\u7b49\u4e8e\u200b k/n\uff0cbias \u200b\u76f4\u63a5\u200b\u53d6\u200b\u4f59\u91cf\u200b\u5206\u5e03\u200b\u7684\u200b k/n \u200b\u5206\u200b\u4f4d\u6570\u200b\uff1a</p> <p> \\(b_i = \\mathrm{Quantile}_{k/n}\\big(\\{d_t\\}\\big)\\)\u3000\u2014\u2014\u200b\u4e0d\u200b\u8fed\u4ee3\u200b\u3001\u200b\u4e0d\u200b\u8bd5\u9519\u200b\u3001\u200b\u65e0\u8d85\u200b\u53c2\u200b\uff0c\u200b\u4e00\u6b65\u5230\u4f4d\u200b\u3002SignSGD \u200b\u5f0f\u200b\u66f4\u65b0\u200b\u672c\u8d28\u200b\u4e0a\u200b\u662f\u200b\u5bf9\u200b\u8fd9\u4e2a\u200b\u95ed\u5f0f\u200b\u89e3\u200b\u7684\u200b\u8e69\u811a\u200b\u968f\u673a\u200b\u903c\u8fd1\u200b\uff08\u200b\u6bcf\u6b21\u200b\u53ea\u200b\u632a\u200b\u4e00\u4e2a\u200b\u7b26\u53f7\u200b\u4f4d\u200b\uff09\uff0c\u200b\u4e13\u5bb6\u200b\u591a\u200b\u4e86\u200b\u5fc5\u7136\u200b\u9707\u8361\u200b\uff1bQB \u200b\u662f\u200b\u76f4\u63a5\u200b\u628a\u200b\u7b54\u6848\u200b\u7b97\u200b\u51fa\u6765\u200b\u3002 </p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#35","title":"3.5 \u200b\u5de5\u7a0b\u200b\u843d\u5730\u200b\uff1a\u200b\u76f4\u65b9\u56fe\u200b\u8fd1\u4f3c\u200b\uff08\u200b\u5229\u7528\u200b\u5206\u5e03\u200b\u53ef\u52a0\u6027\u200b\uff09","text":"<p>\u200b\u5206\u200b\u4f4d\u6570\u200b\u662f\u200b\u975e\u7ebf\u6027\u200b\u8fd0\u7b97\u200b\uff1a\u200b\u4e0d\u80fd\u200b\u5404\u5361\u7b97\u200b\u5404\u200b\u7684\u200b\u518d\u200b\u5e73\u5747\u200b\uff08\u200b\u5c40\u200b\u90e8\u5206\u200b\u4f4d\u6570\u200b+\u200b\u5168\u5c40\u200b\u5e73\u5747\u200b\u5728\u200b\u89c4\u6a21\u200b\u5927\u540e\u200b\u5931\u771f\u200b\uff09\uff1b\u200b\u6734\u7d20\u200b all-gather \u200b\u5168\u4f53\u200b\u5206\u6570\u200b\u901a\u4fe1\u200b\u7206\u70b8\u200b\u3002K3 \u200b\u7684\u200b\u89e3\u6cd5\u200b\uff1a</p> <pre><code>\u2460 \u200b\u628a\u200b\u4f59\u91cf\u200b d_t \u200b\u538b\u7f29\u200b\u5230\u200b [0,1]\n\u2461 \u200b\u672c\u5730\u200b\u5efa\u200b\u76f4\u65b9\u56fe\u200b\uff1a1000 \u200b\u4e2a\u200b bin \u200b\u7684\u200b\u8ba1\u6570\u200b\u5411\u91cf\u200b      \u2190 \u200b\u975e\u7ebf\u6027\u200b\u6d88\u5931\u200b\uff0c\u200b\u53ea\u200b\u5269\u200b\u8ba1\u6570\u200b\n\u2462 \u200b\u8de8\u200b\u673a\u5668\u200b / \u200b\u8de8\u200b\u68af\u5ea6\u200b\u7d2f\u79ef\u200b\uff1a\u200b\u76f4\u65b9\u56fe\u200b\u76f4\u63a5\u200b\u76f8\u52a0\u200b        \u2190 \u200b\u5206\u5e03\u200b\u7684\u200b\u53ef\u52a0\u6027\u200b\uff01\n\u2463 \u200b\u4ece\u200b\u5168\u5c40\u200b\u76f4\u65b9\u56fe\u200b CDF \u200b\u8bfb\u51fa\u200b k/n \u200b\u5206\u200b\u4f4d\u6570\u200b \u2192 b_i\n</code></pre> <ul> <li>\u200b\u901a\u4fe1\u91cf\u200b\u4ece\u200b\"\u200b\u5168\u4f53\u200b\u5206\u6570\u200b\"\u200b\u964d\u5230\u200b\"\u200b\u6bcf\u200b\u4e13\u5bb6\u200b 1000 \u200b\u4e2a\u200b\u8ba1\u6570\u200b\"\uff08896\u00d71000 \u2248 3.5MB\uff0c\u200b\u51e0\u4e4e\u200b\u514d\u8d39\u200b\uff09\uff1b</li> <li>bin \u200b\u6570\u200b\u6d88\u878d\u200b\uff1a10000 bin \u200b\u5bf9\u6bd4\u200b 1000 bin \u200b\u65e0\u200b\u989d\u5916\u200b\u6536\u76ca\u200b \u2192 1000 \u200b\u591f\u7528\u200b\u3002</li> </ul>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#4-kda","title":"4. KDA \u200b\u7684\u200b\u8870\u51cf\u200b\u673a\u5236","text":"<p>https://zhuanlan.zhihu.com/p/2064688483621397412</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#41","title":"4.1 \u200b\u72b6\u6001\u200b\u66f4\u65b0\u200b\uff1a\u200b\u8870\u51cf\u200b + \u200b\u64e6\u9664\u200b + \u200b\u5199\u5165","text":"\\[S_t = \\mathrm{diag}(\\alpha_t)\\, S_{t-1}\\,(I - \\beta_t k_t k_t^\\top) + \\beta_t k_t v_t^\\top\\] <ul> <li>\\(\\mathrm{diag}(\\alpha_t)\\)\uff1a\u200b\u8870\u51cf\u200b\uff08\u200b\u9057\u5fd8\u200b\uff09\u2014\u2014\u200b\u672c\u6587\u200b\u4e3b\u89d2\u200b\uff1b</li> <li>\\((I - \\beta_t k_t k_t^\\top)\\)\uff1adelta rule \u200b\u64e6\u9664\u200b\u2014\u2014\u200b\u6309\u200b\u5f53\u524d\u200b key \u200b\u65b9\u5411\u200b\u6e05\u6389\u200b\u65e7\u200b\u54cd\u5e94\u200b\uff08\u200b\u6570\u5b66\u200b\u4e0a\u200b = \u200b\u5bf9\u200b\"\u200b\u5f53\u524d\u200b key \u200b\u7684\u200b\u56de\u8bfb\u200b\u8bef\u5dee\u200b\"\u200b\u505a\u200b\u4e00\u6b65\u200b\u68af\u5ea6\u200b\u4e0b\u964d\u200b\uff09\uff1b</li> <li>\\(+ \\beta_t k_t v_t^\\top\\)\uff1a\u200b\u5199\u5165\u200b\u65b0\u503c\u200b\u3002</li> </ul>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#42","title":"4.2 \u200b\u64e6\u9664\u200b\u662f\u200b\u600e\u4e48\u200b\u5b8c\u6210\u200b\u7684\u200b\uff1a\u200b\u65b9\u5411\u6027\u200b\u5bf9\u6d88","text":"<p>\u200b\u5e38\u89c1\u200b\u7591\u60d1\u200b\uff1a\u200b\u72b6\u6001\u200b \\(S = \\sum_j k_j v_j^\\top\\) \u200b\u53ea\u662f\u200b\u5916\u79ef\u200b\u7684\u200b\u7d2f\u52a0\u200b\u548c\u200b\uff0c\u200b\u6ca1\u6709\u200b\u4efb\u4f55\u200b\u6761\u76ee\u200b\u7ed3\u6784\u200b\uff0c\u200b\u600e\u4e48\u200b\"\u200b\u64e6\u6389\u200b\u524d\u9762\u200b\u5199\u5165\u200b\u7684\u200b\"\uff1f\u200b\u7b54\u6848\u200b\uff1a\u200b\u6cbf\u67d0\u200b\u65b9\u5411\u200b\u7684\u200b\u65e7\u200b\u54cd\u5e94\u200b\u662f\u200b\u603b\u548c\u200b\u7684\u200b\u7ebf\u6027\u200b\u6295\u5f71\u200b\uff0c\u200b\u53ef\u4ee5\u200b\u76f4\u63a5\u200b\u4ece\u200b\u603b\u548c\u200b\u91cc\u200b\u8bfb\u51fa\u6765\u200b\u3001\u200b\u518d\u200b\u51cf\u6389\u200b\u2014\u2014\u200b\u4e0d\u200b\u9700\u8981\u200b\u5b9a\u4f4d\u200b\u5230\u200b\"\u200b\u54ea\u200b\u4e00\u7b14\u200b\"\uff1a</p> <p>\\(k^\\top S = \\sum_j (k^\\top k_j)\\, v_j^\\top\\)\u3000\uff08\u200b\u6240\u6709\u200b\u65e7\u200b\u8bb0\u5fc6\u200b\u6309\u200b\u4e0e\u200b k \u200b\u7684\u200b\u76f8\u4f3c\u200b\u5ea6\u200b\u52a0\u6743\u200b\u7684\u200b\u603b\u548c\u200b\uff0c\u200b\u4e00\u6b21\u200b\u77e9\u9635\u200b\u4e58\u200b\uff09</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#d_k2key","title":"\u6570\u5b57\u200b\u4f8b\u5b50\u200b\uff08d_k=2\uff0ckey \u200b\u5df2\u200b\u5f52\u4e00\u5316\u200b\uff09","text":"<p>\u2460 \u200b\u6b63\u4ea4\u200b\u65b9\u5411\u200b\u4e92\u4e0d\u200b\u5e72\u6270\u200b\uff1a</p> <pre><code>t1: k\u2081=(1,0), v\u2081=5  \u2192 S = [5, 0]\u1d40\nt2: k\u2082=(0,1), v\u2082=3  \u2192 S = [5, 3]\u1d40\n\u200b\u8bfb\u200b q=(1,0) \u200b\u5f97\u200b 5\uff0c\u200b\u8bfb\u200b q=(0,1) \u200b\u5f97\u200b 3 \u2014\u2014 k\u2081\u1d40k\u2082=0\uff0c\u200b\u5404\u200b\u65b9\u5411\u200b\u4e92\u4e0d\u200b\u63ba\u548c\u200b\n</code></pre> <p>\u2461 \u200b\u540c\u65b9\u5411\u200b\u8986\u5199\u200b\uff1a\u200b\u64e6\u200b vs \u200b\u4e0d\u64e6\u200b\uff1a</p> <pre><code>t3: k\u2083=(1,0)\uff08\u200b\u4e0e\u200b t1 \u200b\u540c\u65b9\u5411\u200b\uff09\uff0cv\u2083=7\n\n\u200b\u4e0d\u64e6\u200b\uff08\u200b\u7eaf\u200b\u7d2f\u52a0\u200b\uff09\uff1aS = [5,3]\u1d40 + (1,0)\u00b77 = [12, 3]\u1d40 \u2192 \u200b\u8bfb\u51fa\u200b 12 = 5+7 \u200b\u6df7\u53e0\u200b \u2717\n\ndelta rule\uff1ar = k\u2083\u1d40S = 5        \uff08\u200b\u67e5\u200b\u65e7\u8d26\u200b\uff1a\u200b\u8fd9\u4e2a\u200b\u65b9\u5411\u200b\u8bb0\u200b\u7684\u200b\u662f\u200b 5\uff09\n            e = 7 \u2212 5 = 2       \uff08\u200b\u5dee\u989d\u200b\uff09\n            S += k\u2083\u00b72 \u2192 [7, 3]\u1d40 \u2192 \u200b\u8bfb\u51fa\u200b\u6070\u597d\u200b 7 \u2713\n            \u200b\u65e7\u200b\u7684\u200b 5 \u200b\u88ab\u200b\u4ee3\u6570\u200b\u4e0a\u200b\u7cbe\u786e\u200b\u62b5\u6d88\u200b\n</code></pre> <p>\u2462 \u200b\u90e8\u5206\u200b\u76f8\u4f3c\u200b = \u200b\u6309\u200b\u6bd4\u4f8b\u200b\u64e6\u200b\uff1a\u200b\u82e5\u200b k\u2083=(cos45\u00b0, sin45\u00b0)\uff0c\u200b\u5219\u200b r = 5\u00d70.71 + 3\u00d70.71 = 5.66\u2014\u2014\u200b\u4e24\u4e2a\u200b\u65b9\u5411\u200b\u7684\u200b\u65e7\u503c\u200b\u5404\u200b\u88ab\u200b\u64e6\u6389\u200b\u4e00\u90e8\u5206\u200b\u3002\u200b\u4e0d\u200b\u5b8c\u5168\u200b\u6b63\u4ea4\u200b\u7684\u200b\u8bb0\u5fc6\u200b\u4f1a\u200b\u4e92\u76f8\u200b\"\u200b\u6e17\u900f\u200b\"\uff0c\u200b\u8fd9\u662f\u200b\u56fa\u5b9a\u200b\u72b6\u6001\u200b\u8bb0\u5fc6\u200b\u7684\u200b\u56fa\u6709\u200b\u4e32\u6270\u200b\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#_1","title":"\u8981\u70b9","text":"<ul> <li>\u200b\u64e6\u9664\u200b\u4e0d\u662f\u200b\"\u200b\u627e\u5230\u200b\u5e76\u200b\u5220\u9664\u200b\"\uff0c\u200b\u662f\u200b\u4e00\u6b21\u200b\u65b9\u5411\u6027\u200b\u5bf9\u6d88\u200b\uff1a\u200b\u4ece\u200b\u6c42\u548c\u200b\u91cc\u200b\u51cf\u53bb\u200b\u8be5\u200b\u65b9\u5411\u200b\u4e0a\u200b\u7684\u200b\u7d2f\u8ba1\u200b\u54cd\u5e94\u200b \\(k_t (k_t^\\top S_{t-1})^\\top\\)\uff1b</li> <li>\\(k k^\\top\\) \u200b\u662f\u200b\u8be5\u200b\u65b9\u5411\u200b\u7684\u200b rank-1 \u200b\u6295\u5f71\u200b\uff1a\u200b\u6b63\u4ea4\u200b\u65b9\u5411\u200b\u8d21\u732e\u200b \u22480 \u200b\u4e0d\u200b\u53d7\u200b\u5f71\u54cd\u200b\uff1bL2Norm \u200b\u4fdd\u8bc1\u200b \\(k^\\top k = 1\\) \u200b\u65f6\u200b \u03b2=1 \u200b\u4e25\u683c\u200b\u6e05\u96f6\u200b\uff08\u200b\u5b8c\u5168\u200b\u540c\u200b\u5411\u200b = \u200b\u6700\u65b0\u200b\u5199\u5165\u200b\u72ec\u5360\u200b\u8be5\u200b\u65b9\u5411\u200b\uff09\uff1b</li> <li>\u200b\u6210\u672c\u200b\u53ea\u6709\u200b O(d_k\u00b7d_v) \u200b\u4e00\u6b21\u200b\u4e58\u52a0\u200b\uff0c\u200b\u5374\u200b\u8fbe\u5230\u200b\"\u200b\u8986\u5199\u200b\"\u200b\u8bed\u4e49\u200b\u2014\u2014\u200b\u8fd9\u200b\u5c31\u662f\u200b delta rule\uff08Widrow-Hoff LMS\uff09\u200b\u540d\u5b57\u200b\u7684\u200b\u7531\u200b\u6765\u200b\uff1a\u200b\u5bf9\u200b\"\u200b\u5f53\u524d\u200b key \u200b\u7684\u200b\u56de\u8bfb\u200b\u8bef\u5dee\u200b\"\u200b\u505a\u200b\u4e00\u6b65\u200b\u68af\u5ea6\u200b\u4e0b\u964d\u200b\u3002</li> </ul>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#43","title":"4.3 \u200b\u8870\u51cf\u200b\u7684\u200b\u4e09\u4e2a\u200b\u7279\u5f81","text":"<ol> <li>\u200b\u9010\u200b key \u200b\u901a\u9053\u200b\uff1a\\(\\alpha_t \\in (0,1)^{d_k}\\)\uff0c\u200b\u4e0d\u662f\u200b\u6807\u91cf\u200b\u2014\u2014\u200b\u8bb0\u5fc6\u200b\u677f\u200b\u6bcf\u200b\u4e00\u5217\u200b\uff08\u200b\u6bcf\u4e2a\u200b key \u200b\u65b9\u5411\u200b\uff09\u200b\u6709\u200b\u81ea\u5df1\u200b\u7684\u200b\u9057\u5fd8\u200b\u901f\u5ea6\u200b\uff0c\u200b\u5373\u200b\"\u200b\u4e0d\u540c\u200b\u901a\u9053\u200b\u7684\u200b\u8bb0\u5fc6\u200b\u5bff\u547d\u200b\u4e0d\u540c\u200b\"\u3002GDN \u200b\u53ea\u6709\u200b\u6807\u91cf\u200b/\u200b\u7c97\u7c92\u5ea6\u200b\u8870\u51cf\u200b\uff0cKDA \u200b\u628a\u200b\u5b83\u200b\u7ec6\u5316\u200b\u5230\u200b\u901a\u9053\u200b\u7c92\u5ea6\u200b\u3002</li> <li>\u200b\u6570\u636e\u200b\u4f9d\u8d56\u200b\uff1a\\(\\alpha_t\\) \u200b\u7531\u200b\u5f53\u524d\u200b\u8f93\u5165\u200b\u5b9e\u65f6\u200b\u751f\u6210\u200b\u2014\u2014\u200b\u6a21\u578b\u200b\u5b66\u4f1a\u200b\"\u200b\u8fd9\u6bb5\u200b\u8be5\u200b\u5fd8\u200b\u3001\u200b\u90a3\u6bb5\u200b\u8be5\u8bb0\u200b\"\uff0c\u200b\u6ca1\u6709\u200b\u628a\u200b\u65f6\u95f4\u5c3a\u5ea6\u200b\u710a\u6b7b\u200b\u5728\u200b\u7ed3\u6784\u200b\u91cc\u200b\u3002</li> <li> <p>\u200b\u5e26\u200b\u4e0b\u754c\u200b\u7684\u200b\u53c2\u6570\u200b\u5316\u200b\uff08K3 \u200b\u7684\u200b\u6570\u503c\u200b\u5173\u952e\u200b\uff09\uff1a</p> </li> <li> <p>GDN / Kimi Linear \u200b\u539f\u7248\u200b\uff1a\\(g_t = -\\mathrm{softplus}(\\cdot)\\)\uff0clog-decay \u200b\u53ef\u4ee5\u200b\u8d8b\u4e8e\u200b \u2212\u221e\uff1b</p> </li> </ol> <p>\u200b\u914d\u5957\u200b\u4ef6\u200b\uff1aShortConv\uff08\u200b\u5757\u200b\u5185\u200b\u77ed\u200b\u5377\u79ef\u200b\u7ed9\u200b\u5c40\u90e8\u200b\u987a\u5e8f\u200b\u611f\u200b\uff09+ q/k L2Norm\uff08\u200b\u63a7\u5236\u200b\u957f\u5ea6\u200b\uff09+ \u200b\u8f93\u51fa\u200b\u95e8\u63a7\u200b\uff08\u200b\u8bfb\u51fa\u200b\u65f6\u200b\u6309\u200b\u8f93\u5165\u200b\u8c03\u5236\u200b\u901a\u9053\u200b\uff09\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#44","title":"4.4 \u200b\u4e00\u53e5\u200b\u8bdd\u200b\u5b9a\u4f4d","text":"<p>\u200b\u56fa\u5b9a\u200b\u72b6\u6001\u200b = \u200b\u53ef\u200b\u7ed3\u5408\u200b\u7684\u200b\u7ebf\u6027\u200b attention \u200b\u7684\u200b\u5fc5\u7136\u7ed3\u679c\u200b\uff1b\u200b\u538b\u7f29\u200b\u8bb0\u5fc6\u200b\u5fc5\u7136\u200b\u53d1\u751f\u200b\u5199\u5165\u200b\u78b0\u649e\u200b\uff1bdelta rule \u200b\u628a\u200b\"\u200b\u8986\u76d6\u200b\u89c4\u5219\u200b\"\u200b\u5199\u6210\u200b\u6700\u5c0f\u5316\u200b\u56de\u8bfb\u200b\u8bef\u5dee\u200b\uff1b\u200b\u9010\u200b\u901a\u9053\u200b\u8870\u51cf\u200b\u8ba9\u200b\u4e0d\u540c\u200b\u8bb0\u5fc6\u200b\u6709\u200b\u4e86\u200b\u5404\u81ea\u200b\u7684\u200b\u4fdd\u8d28\u671f\u200b\u3002KDA \u200b\u7684\u200b\u89d2\u8272\u200b\uff1a\u200b\u627f\u62c5\u200b\u5927\u90e8\u5206\u200b\u9ad8\u9891\u200b\u3001\u200b\u4f4e\u6210\u672c\u200b\u7684\u200b\u72b6\u6001\u200b\u66f4\u65b0\u200b\uff0c\u200b\u628a\u200b\u7cbe\u786e\u200b\u5168\u5c40\u200b\u68c0\u7d22\u200b\u8ba9\u7ed9\u200b\u5c11\u6570\u200b MLA \u200b\u5c42\u200b\uff0869:24\uff0c\u22483:1\uff0cblock \u200b\u5185\u200b 3 KDA + 1 Gated MLA\uff0c\u200b\u6700\u540e\u200b\u4e00\u5c42\u200b\u4e3a\u200b MLA\uff09\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#5-mlamulti-head-latent-attention","title":"5. MLA\uff08Multi-head Latent Attention\uff09","text":"<p>MLA \u200b\u662f\u200b DeepSeek-V2 \u200b\u63d0\u51fa\u200b\u7684\u200b\u6ce8\u610f\u529b\u200b\u53d8\u4f53\u200b\uff0c\u200b\u76ee\u6807\u200b\uff1a\u200b\u628a\u200b KV Cache \u200b\u538b\u5c0f\u200b\u4e00\u4e2a\u200b\u91cf\u7ea7\u200b\uff0c\u200b\u540c\u65f6\u200b\u4e0d\u200b\u6389\u200b\u6548\u679c\u200b\u3002K3 \u200b\u7684\u200b 93 \u200b\u5c42\u91cc\u200b 24 \u200b\u5c42\u7528\u200b\u5b83\u200b\uff08Gated MLA\uff09\uff0c\u200b\u5176\u4f59\u200b 69 \u200b\u5c42\u200b\u662f\u200b KDA\uff08\u200b\u65e0\u200b cache\uff0c\u200b\u56fa\u5b9a\u200b\u72b6\u6001\u200b\uff09\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#51-kv-cache","title":"5.1 \u200b\u8981\u200b\u89e3\u51b3\u200b\u7684\u200b\u95ee\u9898\u200b\uff1aKV Cache \u200b\u592a\u80d6","text":"<p>softmax attention \u200b\u6bcf\u4e2a\u200b\u5386\u53f2\u200b token \u200b\u90fd\u200b\u8981\u200b\u5b58\u200b K\u3001V\u3002\u200b\u4ee5\u200b 96 \u200b\u5934\u200b \u00d7 \u200b\u6bcf\u5934\u200b 128 \u200b\u7ef4\u8ba1\u200b\uff1acache = 2\u00d796\u00d7128 = 24576 \u200b\u4e2a\u6570\u200b / token / \u200b\u5c42\u200b\uff0c1M context \u200b\u4e0b\u200b\u662f\u200b\u5929\u6587\u6570\u5b57\u200b\u3002MQA/GQA \u200b\u7528\u200b\"\u200b\u5171\u4eab\u200b\u5934\u200b\"\u200b\u780d\u200b cache\uff0c\u200b\u4f46\u200b\u8868\u8fbe\u529b\u200b\u53d7\u635f\u200b\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#52","title":"5.2 \u200b\u7ed3\u6784\u200b\uff1a\u200b\u5b58\u200b\u538b\u7f29\u5305\u200b\uff0c\u200b\u7528\u65f6\u200b\u89e3\u538b","text":"<pre><code>\u200b\u5199\u5165\u200b\uff1ax_t \u2500\u2500W_down(\u200b\u5171\u4eab\u200b)\u2500\u2500\u2192 c_t \u2208 R^512     \u2190 KV \u200b\u538b\u6210\u200b\u4e00\u4e2a\u200b latent\uff0c\u3010\u200b\u53ea\u5b58\u200b\u5b83\u200b\u3011\n\u200b\u8bfb\u53d6\u200b\uff1ac_t \u2500\u2500W_UK\u2500\u2500\u2192 96 \u200b\u4e2a\u5934\u200b\u7684\u200b K\uff08\u200b\u6bcf\u5934\u200b 192 \u200b\u7ef4\u200b\uff09\n      c_t \u2500\u2500W_UV\u2500\u2500\u2192 96 \u200b\u4e2a\u5934\u200b\u7684\u200b V\uff08\u200b\u6bcf\u5934\u200b 128 \u200b\u7ef4\u200b\uff09\n</code></pre> <p>cache \u200b\u5bf9\u6bd4\u200b\uff1aMHA 24576 vs MLA 512+64=576\uff08\u200b\u7ea6\u200b 1/43\uff1b64 \u200b\u662f\u200b RoPE \u200b\u89e3\u200b\u8026\u4f4d\u200b\uff09\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#53-absorb","title":"5.3 \u200b\u5173\u952e\u200b\u673a\u5236\u200b\uff1a\u200b\u89e3\u7801\u200b\u65f6\u200b\u7684\u200b\"\u200b\u5438\u6536\u200b\"\uff08absorb\uff09","text":"<p>\u200b\u4e0a\u200b\u6295\u5f71\u200b W_UK/W_UV \u200b\u662f\u200b\u5171\u4eab\u200b\u7ebf\u6027\u200b\u5c42\u200b\uff0c\u200b\u53ef\u200b\u632a\u5230\u200b query \u200b\u4fa7\u200b\"\u200b\u5438\u6536\u200b\"\u200b\u6389\u200b\uff1a</p> \\[\\mathrm{score}(q_i, k_j) = q_i^\\top W_{UK} c_j = (W_{UK}^\\top q_i)^\\top c_j\\] <p>\u200b\u53f3\u8fb9\u200b\u62ec\u53f7\u200b\u91cc\u200b\u5bf9\u200b\u6bcf\u4e2a\u200b query \u200b\u53ea\u7b97\u200b\u4e00\u6b21\u200b\u3002\u200b\u4e8e\u662f\u200b\u89e3\u7801\u200b\u65f6\u200b\u6839\u672c\u200b\u4e0d\u7528\u200b\u89e3\u538b\u200b\u2014\u201496 \u200b\u4e2a\u200b query \u200b\u76f4\u63a5\u200b\u5bf9\u200b\u7740\u200b 512 \u200b\u7ef4\u200b\u5171\u4eab\u200b latent \u200b\u6253\u5206\u200b\uff0c\u200b\u7b49\u4ef7\u200b\u4e8e\u200b head_dim=512+ \u200b\u7684\u200b MQA\uff08\u200b\u6240\u6709\u200b\u5934\u200b\u5171\u4eab\u200b\u4e00\u4e2a\u200b\u8d85\u5927\u200b K/V\uff09\u3002\u200b\u6ce8\u610f\u200b RoPE \u200b\u4e0e\u200b\u4f4e\u200b\u79e9\u200b\u538b\u7f29\u200b\u4e0d\u200b\u517c\u5bb9\u200b\uff08\u200b\u4f4d\u7f6e\u200b\u65cb\u8f6c\u200b\u77e9\u9635\u200b\u5939\u200b\u5728\u200b\u4e2d\u95f4\u200b\u7834\u574f\u200b\u7ed3\u5408\u5f8b\u200b\u3001\u200b\u65e0\u6cd5\u200b\u88ab\u200b\u5438\u6536\u200b\uff09\uff0c\u200b\u6240\u4ee5\u200b\u5355\u72ec\u200b\u8d70\u200b\u4e00\u4e2a\u200b\u5c0f\u200b\u7684\u200b\u89e3\u200b\u8026\u200b\u5206\u91cf\u200b\uff0864 \u200b\u7ef4\u200b\u3001MQA \u200b\u5f0f\u200b\u5168\u5934\u200b\u5171\u4eab\u200b\uff09\u2014\u2014\u200b\u8fd9\u200b\u5c31\u662f\u200b\"\u200b\u62fc\u63a5\u200b 64 \u200b\u7ef4\u200b\"\u200b\u7684\u200b\u7531\u200b\u6765\u200b\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#54","title":"5.4 \u200b\u4e3a\u4ec0\u4e48\u200b\u538b\u7f29\u200b\u4e86\u200b\u6548\u679c\u200b\u4e0d\u200b\u6389","text":"<p>\u300aMLA \u200b\u597d\u200b\u5728\u200b\u54ea\u91cc\u200b\u300b\u200b\u7cfb\u5217\u200b\u7684\u200b\u5b9e\u9a8c\u200b\u7ed3\u8bba\u200b\uff1a\u200b\u6548\u679c\u200b\u7684\u200b\u5173\u952e\u200b\u662f\u200b\"\u200b\u65e0\u5f62\u200b\u7684\u200b head_dims \u200b\u53d8\u200b\u5927\u200b\"\u2014\u2014latent \u200b\u8ba9\u200b\u6bcf\u5934\u200b\u7684\u200b\u6709\u6548\u200b\u89c6\u91ce\u200b\u662f\u200b 512 \u200b\u7ef4\u200b\u5171\u4eab\u200b\u7a7a\u95f4\u200b\uff1b\u200b\u7ed9\u5b9a\u200b cache \u200b\u9884\u7b97\u200b\uff0c\u200b\u7406\u8bba\u200b\u6700\u4f18\u200b\u662f\u200b\"head_dims = cache \u200b\u5927\u5c0f\u200b\u3001K=V \u200b\u5171\u4eab\u200b\u7684\u200b MQA\"\u3002MLA \u200b\u4e24\u5934\u200b\u5360\u200b\uff1a\u200b\u8bad\u7ec3\u200b\u65f6\u50cf\u200b MHA\uff08\u200b\u597d\u8bad\u200b\u3001\u200b\u6548\u679c\u200b\u597d\u200b\uff09\uff0c\u200b\u89e3\u7801\u200b\u65f6\u50cf\u200b\u5927\u200b head_dims MQA\uff08cache \u200b\u5c0f\u200b\u3001\u200b\u8d28\u91cf\u200b\u4fdd\u4f4f\u200b\uff09\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#55","title":"5.5 \u200b\u4ee3\u4ef7\u200b\u4e0e\u200b\u56db\u200b\u6761\u4ef6\u200b\u53d6\u820d","text":"<ul> <li>MLA \u200b\u89e3\u7801\u200b\u5df2\u200b\u662f\u200b head_dims=512+ \u200b\u7684\u200b MQA\uff0c\u200b\u7b97\u529b\u200b\u63d0\u524d\u200b\u8017\u5149\u200b \u2192 \u200b\u914d\u200b MTP\uff08\u200b\u63a8\u6d4b\u200b\u89e3\u7801\u200b\uff0c\u200b\u8ba1\u7b97\u200b\u6362\u200b\u901f\u5ea6\u200b\uff09\u200b\u5403\u4e8f\u200b\uff1b</li> <li>\u200b\u5f80\u5c0f\u6539\u200b\uff08GQA8 128+128\uff09\uff1a\u200b\u6548\u679c\u200b\u6253\u200b\u4e0d\u8fc7\u200b MLA\uff1b\u200b\u5c31\u7b97\u200b\u6253\u5e73\u200b\uff0ccache \u200b\u4e5f\u200b\u662f\u200b MLA \u200b\u4e09\u500d\u200b\u591a\u200b\uff1b</li> <li>\u200b\u5f80\u5927\u6539\u200b\uff08MFA 256+256\uff0c\u200b\u672c\u8d28\u200b MQA\uff09\uff1a\u200b\u6548\u679c\u200b\u8ffd\u5e73\u200b\u3001cache \u200b\u4e0d\u200b\u591a\u200b\uff0c\u200b\u4f46\u200b\u8bad\u7ec3\u200b\u6210\u672c\u200b\u6da8\u200b\uff08Scaling Law \u200b\u5403\u4e8f\u200b\uff09\u3001Prefill \u200b\u4e5f\u200b\u53d8\u8d35\u200b\uff08Agent/Coding \u200b\u6bcf\u8f6e\u200b prefill \u200b\u4e0d\u77ed\u200b\uff09\u3002</li> </ul> <p>\u200b\u6bd4\u200b MLA \u200b\u66f4\u597d\u200b\u7684\u200b\u8bbe\u8ba1\u200b\u5fc5\u987b\u200b\u540c\u65f6\u200b\u6ee1\u8db3\u200b\uff1a\u2460\u200b\u6548\u679c\u200b \u2265 MLA\u3000\u2461\u200b\u8bad\u7ec3\u200b+Prefill \u200b\u6210\u672c\u200b \u2264 MLA\u3000\u2462KV Cache &lt; MLA\u3000\u2463Decoding \u200b\u8ba1\u7b97\u200b &lt; MLA\u2014\u2014\u200b\u76ee\u524d\u200b\u6ca1\u6709\u200b\u8bbe\u8ba1\u200b\u80fd\u200b\u540c\u65f6\u200b\u6ee1\u8db3\u200b\uff0c\u200b\u5fc5\u987b\u200b\u53d6\u820d\u200b\u3002K3 \u200b\u91cc\u200b KDA \u200b\u627f\u62c5\u200b\u5927\u90e8\u5206\u200b\u5c42\u200b\u7684\u200b\u5e8f\u5217\u200b\u6df7\u5408\u200b\uff0cMLA \u200b\u53ea\u7559\u200b 24 \u200b\u5c42\u200b\uff0c\u200b\u5176\u200b\u6210\u672c\u200b\u95ee\u9898\u200b\u88ab\u200b\"\u200b\u7a00\u91ca\u200b\"\uff0c\u200b\u6240\u4ee5\u200b\u6743\u8861\u200b\u540e\u200b\u4ecd\u200b\u9009\u200b MLA\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#56-dsv4-mla","title":"5.6 \u200b\u63d2\u66f2\u200b\uff1aDSV4 \u200b\u6ca1\u6709\u200b\u629b\u5f03\u200b MLA","text":"<p>DSV4 \u200b\u770b\u4f3c\u200b\u53e6\u8d77\u7089\u7076\u200b\uff0c\u200b\u5b9e\u9645\u200b\u662f\u200b\u628a\u200b MLA \u200b\u7684\u200b\u89e3\u7801\u200b\u5f62\u6001\u200b\uff08head_dims=512\u3001K=V \u200b\u7684\u200b MQA\uff09\u200b\u76f4\u63a5\u200b\u5f53\u6210\u200b\u4e86\u200b\u8bad\u7ec3\u200b\u5f62\u6001\u200b\u2014\u2014\u200b\u6309\u200b\u7406\u8bba\u200b\u6700\u4f18\u200b\u89e3\u8d70\u200b\u5230\u5e95\u200b\uff1b\u200b\u4ee3\u4ef7\u200b\u9760\u200b Sparse\uff08\u200b\u7701\u200b\u8ba1\u7b97\u200b\uff09+ Compress\uff08\u200b\u538b\u200b cache\uff09\u200b\u627e\u8865\u200b\u3002\u200b\u8bc4\u4ef7\u200b\uff1a\"\u200b\u4e0d\u662f\u200b\u629b\u5f03\u200b\u548c\u200b\u91cd\u9020\u200b\uff0c\u200b\u662f\u200b\u4f20\u627f\u200b\u548c\u200b\u5347\u7ea7\u200b\u5230\u200b\u53e6\u200b\u4e00\u4e2a\u200b\u6781\u81f4\u200b\"\u3002\u200b\u4f46\u200b \"Linear+Full\" \u200b\u8def\u7ebf\u200b vs \"Sparse\" \u200b\u8def\u7ebf\u200b\u8c01\u200b\u8d70\u200b\u66f4\u200b\u8fdc\u200b\uff0c\u200b\u5c1a\u65e0\u200b\u5b9a\u8bba\u200b\u3002</p>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#57-k3","title":"5.7 K3 \u200b\u7684\u200b\u4e24\u4e2a\u200b\u81ea\u5bb6\u200b\u6539\u52a8","text":"<ul> <li>Gated MLA\uff1a\u200b\u8f93\u51fa\u200b\u52a0\u200b data-dependent \u200b\u95e8\u63a7\u200b\uff08\u200b\u4e0e\u200b KDA \u200b\u7684\u200b\u8f93\u51fa\u200b\u95e8\u200b\u547c\u5e94\u200b\u2014\u2014attention \u200b\u8bfb\u51fa\u200b\u518d\u200b\u88ab\u200b\u5f53\u524d\u200b\u8f93\u5165\u200b\u8c03\u5236\u200b\u4e00\u904d\u200b\uff09\uff1b</li> <li>NoPE\uff1a\u200b\u53bb\u6389\u200b RoPE\u2014\u2014\u200b\u56e0\u4e3a\u200b KDA \u200b\u9690\u542b\u200b\u63d0\u4f9b\u200b\u4e86\u200b\"\u200b\u5e7f\u4e49\u200b RoPE\"\uff08\u200b\u89c1\u200b\u7b2c\u200b 6 \u200b\u8282\u200b\u8ba8\u8bba\u200b\uff09\uff1b</li> <li>\u200b\u5de5\u7a0b\u200b\u7ec6\u8282\u200b\uff1a\u200b\u4fdd\u7559\u200b\"\u200b\u62fc\u63a5\u200b 64 \u200b\u7ef4\u200b RoPE \u200b\u69fd\u200b\u4f4d\u200b\"\u200b\u7684\u200b\u65e7\u200b\u7ed3\u6784\u200b\u800c\u200b\u4e0d\u200b\u76f4\u63a5\u200b\u6295\u5f71\u200b 576 \u200b\u7ef4\u200b latent\u2014\u2014\u200b\u517c\u5bb9\u200b\u73b0\u6709\u200b MLA \u200b\u57fa\u5efa\u200b\u3001\u200b\u8ba1\u7b97\u200b\u66f4\u7701\u200b\u65e0\u200b\u6536\u76ca\u200b\u3001\u200b\u4e14\u200b K3 \u200b\u65b0\u200b\u53d8\u91cf\u200b\u5df2\u7ecf\u200b\u591f\u200b\u591a\u200b\uff08\"\u200b\u996d\u8981\u200b\u4e00\u53e3\u200b\u4e00\u53e3\u200b\u5403\u200b\"\uff09\u3002</li> </ul>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#58","title":"5.8 \u200b\u53c2\u8003","text":"<ul> <li>\u200b\u79d1\u5b66\u200b\u7a7a\u95f4\u200b\u300a\u200b\u7b80\u5355\u200b\u8c08\u8c08\u200bK3\u200b\u7684\u200bMoE\u200b\u548c\u200bAttention\u300b\uff08\u200b\u672c\u6587\u200b\u4e3b\u6e90\u200b\uff09</li> <li>\u200b\u77e5\u4e4e\u200b\u00b7\u200b\u59dc\u5bcc\u6625\u200b\u300a\u200b\u5f7b\u5e95\u200b\u7406\u89e3\u200b MLA\uff08Multi-Head Latent Attention\uff09\u300b\u2014\u2014MLA \u200b\u516c\u5f0f\u200b\u9010\u884c\u200b + \u200b\u77e9\u9635\u200b\u5438\u6536\u200b\u63a8\u5bfc\u200b\uff0c\u200b\u5199\u5f97\u200b\u6700\u7ec6\u200b</li> </ul>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E5%A4%A7%E6%A8%A1%E5%9E%8B/k3%E5%88%86%E6%9E%90/#6","title":"6. \u200b\u5f85\u200b\u8ba8\u8bba","text":"<ul> <li>NoPE \u200b\u4e0e\u200b KDA \u200b\u7684\u200b\"\u200b\u5e7f\u4e49\u200b RoPE\"\uff08PaTH \u200b\u7b49\u4ef7\u200b\u5f62\u5f0f\u200b\uff09</li> </ul>","tags":["LLM","MoE","\u7ebf\u6027\u6ce8\u610f\u529b","MLA"]},{"location":"%E9%9A%8F%E7%AC%94/","title":"\u968f\u7b14","text":"<p>\uff08\u200b\u7a7a\u200b\uff09</p>"}]}